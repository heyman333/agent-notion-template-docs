{
  "description": "notion-doc: checks that written HTML documents follow the style canon.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/notion-doc-lint.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/notion-doc-lint.py\" || true",
            "timeout": 10,
            "statusMessage": "Checking notion-doc canon..."
          }
        ]
      }
    ]
  }
}
